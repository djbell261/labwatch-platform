POSTGRES_DB=labwatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5435

LABWATCH_SPRING_PROFILE=demo

HEALTH_EVENTS_TOPIC=health-events
ALERT_EVENTS_TOPIC=alert-events
ANOMALY_EVENTS_TOPIC=anomaly-events
AI_INVESTIGATION_EVENTS_TOPIC=ai-investigation-events

LOGGING_LEVEL_ROOT=INFO

LABWATCH_AUTH_ENABLED=false
LABWATCH_AGENT_AUTH_ENABLED=false
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRATION_MINUTES=60

LABWATCH_KAFKA_RETRY_ATTEMPTS=3
LABWATCH_KAFKA_RETRY_BACKOFF_MS=1000

LABWATCH_NOTIFICATIONS_COOLDOWN_SECONDS=300
LABWATCH_NOTIFICATIONS_EMAIL_ENABLED=false
LABWATCH_ALERT_EMAIL_TO=
LABWATCH_ALERT_EMAIL_FROM=labwatch@localhost

SPRING_DATA_REDIS_TIMEOUT=2s

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LABWATCH_AI_INVESTIGATION_CONCURRENCY=4
LABWATCH_AI_INVESTIGATION_QUEUE_CAPACITY=100
LABWATCH_AI_INVESTIGATION_TIMEOUT_MS=15000

LABWATCH_AI_ANOMALY_PROMOTION_ENABLED=true
LABWATCH_AI_ANOMALY_PROMOTION_COOLDOWN_SECONDS=300
